{
  "name": "pi-ssh-console",
  "version": "1.0.0",
  "description": "SSH client extension for pi with live host reachability, Linux CPU/memory use and tunnel overviews. Tools, commands and skills remain compatible with pi-ssh.",
  "keywords": [
    "pi-package",
    "pi-extension",
    "ssh",
    "sftp",
    "remote",
    "ssh2",
    "pi-ssh-console"
  ],
  "author": "littlepenguin",
  "contributors": [
    "Patrick Weppelmann"
  ],
  "license": "MIT",
  "files": [
    "index.ts",
    "src",
    "skills"
  ],
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "echo 'No build step defined'",
    "test": "node --experimental-test-module-mocks --experimental-test-coverage --test 'tests/**/*.test.ts'",
    "test:watch": "node --experimental-test-module-mocks --test --watch 'tests/**/*.test.ts'",
    "test:coverage": "node --experimental-test-module-mocks --experimental-test-coverage --test 'tests/**/*.test.ts'"
  },
  "dependencies": {
    "ssh2": "^1.17.0"
  },
  "peerDependencies": {
    "typebox": "*"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@semantic-release/git": "^11.0.1",
    "@types/ssh2": "^1.15.6",
    "semantic-release": "^25.0.9",
    "typebox": "^1.3.27",
    "yaml": "^2.9.1"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ],
    "skills": [
      "./skills"
    ]
  }
}
